# ============================================================
# Mini Office AI — Environment Configuration
# Copy to .env and fill in your credentials (never commit .env)
# ============================================================

PORT=3001
NODE_ENV=development

# 1. Neon PostgreSQL (Free tier, no credit card needed: https://neon.tech)
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. OpenRouter API Key (Single key for Claude, Gemini, GPT, DeepSeek: https://openrouter.ai)
# Leave empty to run in Smart Demo Simulation Mode
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://mini-office-ai.onrender.com
OPENROUTER_APP_NAME=Mini Office AI

# Optional model overrides on OpenRouter
MODEL_SUPPORT_AGENT=openai/gpt-4o-mini
MODEL_JURY_CLAUDE=anthropic/claude-3.5-haiku
MODEL_JURY_GEMINI=google/gemini-2.0-flash-001
MODEL_JURY_GPT=openai/gpt-4o-mini
MODEL_JURY_DEEPSEEK=deepseek/deepseek-chat

# 3. VirusTotal API v3 (Free tier: 4 req/min, https://www.virustotal.com)
VIRUSTOTAL_API_KEY=

# 4. Demo Protection (Optional PIN/passcode to protect public Render URL)
DEMO_ACCESS_CODE=
DAILY_AI_BUDGET_CALLS=200

# 5. Twilio SMS Webhook (Optional — ready when client activates real US SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_CLEANING=
TWILIO_PHONE_REALESTATE=
